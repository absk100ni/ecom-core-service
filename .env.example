# ==================== CORE ====================
PORT=8080
ENVIRONMENT=production          # "development" or "production"
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ecom?retryWrites=true&w=majority
MONGO_DB=ecom

# ==================== SECURITY ====================
JWT_SECRET=change-me-to-a-strong-random-string-64-chars
CORS_ORIGINS=https://yourstore.com,https://admin.yourstore.com

# ==================== LOGGING (Grafana/Loki) ====================
LOG_LEVEL=info                  # debug, info, warn, error
LOG_FORMAT=json                 # "json" for Grafana/Loki, "text" for local dev

# ==================== AUTH (OTP) ====================
OTP_SERVICE=mock                # "mock" for dev, "msg91" for production
MSG91_AUTH_KEY=                  # Get from msg91.com → Developers → API Keys
MSG91_TEMPLATE_ID=              # Get from msg91.com → OTP → Templates

# ==================== GOOGLE SIGN-IN ====================
GOOGLE_CLIENT_ID=               # Google OAuth 2.0 Client ID. Required for prod; in dev, mock-google:<email> tokens accepted when unset.

# ==================== PAYMENTS ====================
PAYMENT_GATEWAY=razorpay        # "razorpay" (default), "stripe", "cashfree" — Stripe parked (India invite-only)

# Stripe (dashboard.stripe.com → Developers → API Keys) — PRIMARY GATEWAY
STRIPE_SECRET_KEY=              # sk_test_... or sk_live_...
STRIPE_PUBLISHABLE_KEY=         # pk_test_... or pk_live_... (returned to client for Elements/PaymentIntent confirmation)
STRIPE_WEBHOOK_SECRET=          # whsec_... (dashboard.stripe.com → Developers → Webhooks → Signing secret)

# Razorpay (dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # dashboard.razorpay.com → Settings → Webhooks (required to verify webhooks in prod)

# Cashfree (merchant.cashfree.com → Developers → API Keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=            # also verifies webhook signatures (x-webhook-signature)
CASHFREE_ENV=sandbox            # "sandbox" or "production"
CASHFREE_RETURN_URL=https://yourstore.com/orders  # where Cashfree redirects after checkout

# ==================== PARTIAL PAYMENT (advance + COD) ====================
PARTIAL_PAYMENT_ENABLED=true    # enable advance+COD split
PARTIAL_PAYMENT_DEFAULT_PERCENT=20  # default % charged upfront (products can override)
ALLOW_FULL_COD=false            # whether to allow 0% advance (full COD)

# ==================== SHIPPING (Shipmozo) ====================
SHIPMOZO_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=            # Shipmozo dashboard → API keys
SHIPMOZO_PRIVATE_KEY=           # Shipmozo dashboard → API keys
SHIPMOZO_WAREHOUSE_ID=          # Optional: warehouse id from GET /get-warehouses (blank = account default)
SHIPPING_WEBHOOK_TOKEN=         # shared secret for webhook auth (x-api-key header). Backward-compat: falls back to SHIPROCKET_WEBHOOK_TOKEN if unset.
WAREHOUSE_PINCODE=110001        # origin pincode used for serviceability / EDD lookups

# ==================== CACHE ====================
REDIS_ADDR=localhost:6379       # leave blank to disable caching

# ==================== STORAGE (S3) ====================
S3_BUCKET=                      # AWS S3 bucket for product images. Unset = local /tmp fallback.
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=             # CDN base URL (e.g. https://cdn.yourstore.com). Falls back to S3 direct URL.

# ==================== ADMIN AUTH ====================
ADMIN_EMAIL=                    # seed admin email (used only when admins collection is empty)
ADMIN_PASSWORD=                 # seed admin password (change immediately after first login!)

# ==================== NOTIFICATIONS ====================
NOTIFICATION_SERVICE_URL=http://localhost:9090

# ==================== EMAIL (SMTP) ====================
SMTP_HOST=                      # SMTP server hostname. Leave blank for mock mode (logs only, no real emails sent)
SMTP_PORT=587                   # SMTP port (587 for STARTTLS)
SMTP_USER=                      # SMTP auth username
SMTP_PASS=                      # SMTP auth password
SMTP_FROM=                      # Sender email address (defaults to SMTP_USER)
SMTP_FROM_NAME=                 # Sender display name (defaults to STORE_NAME)

# ==================== WHATSAPP (Meta Cloud API) ====================
WHATSAPP_ACCESS_TOKEN=          # Meta Business system-user token. Blank = mock mode (logs only)
WHATSAPP_PHONE_NUMBER_ID=       # From WhatsApp Manager > API Setup (numeric ID, not the phone number)
WHATSAPP_TEMPLATE_LANG=en       # Language code of your approved templates
WHATSAPP_TPL_ORDER_CONFIRMED=order_confirmed   # Approved template names in Meta Business Manager
WHATSAPP_TPL_ORDER_SHIPPED=order_shipped       # (params documented in internal/notify/whatsapp.go)
WHATSAPP_TPL_REFUND=refund_processed

# ==================== STORE BRANDING ====================
STORE_NAME=ElectroMart          # Store display name in emails and invoices
STORE_URL=https://electromart.in  # Public storefront URL (used in email links)

# ==================== CONTACT FORM ====================
CONTACT_NOTIFY_EMAIL=           # Admin email to receive contact form submissions. If unset, contact emails are logged only.

# ==================== GST / INVOICE ====================
BUSINESS_LEGAL_NAME=ElectroMart Private Limited  # Seller legal name on invoices
BUSINESS_ADDRESS=               # Seller address (appears on invoice header)
BUSINESS_GSTIN=                 # Seller GSTIN (e.g. 07AAACW1234A1Z5)
BUSINESS_STATE=Delhi            # Seller state (for intra/inter-state GST split logic)
BUSINESS_STATE_CODE=07          # Seller state code (2-digit, on invoice)
DEFAULT_GST_PERCENT=18          # Default GST rate when product.gst_percent is unset
DEFAULT_HSN_CODE=8471           # Default HSN code when product.hsn_code is unset

# ==================== RETURNS ====================
RETURN_WINDOW_DAYS=7            # Number of days after delivery within which returns are accepted

# ==================== SENTRY (Error Reporting) ====================
SENTRY_DSN=                     # sentry.io → Project → Settings → Client Keys (DSN). Free tier = 5k events/mo; app self-caps at 5/hr. Unset = disabled.
